{
  "name": "4002-fs-labs",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "start:frontend": "npm run dev --workspace=@complexicon/frontend",
    "start:backend": "npm run dev --workspace=@complexicon/backend",
    "dev": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "build": "npm run build --workspace=@complexicon/frontend && npm run build --workspace=@complexicon/backend",
    "lint": "npm run lint --workspace=@complexicon/frontend"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "~6.0.2"
  }
}
